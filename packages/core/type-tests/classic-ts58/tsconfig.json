{
  // MyTonWallet's compiler options, without its own global declarations
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "webworker", "es2021", "es2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react"
  },
  "include": ["src"]
}
