{
  "name": "teact-workspace",
  "private": true,
  "description": "Teact monorepo: the @teact/core package and its demo",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w @teact/core",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:browser && npm run test:dist",
    "test:unit": "npm run test:unit -w @teact/core",
    "test:browser": "npm run test:browser -w @teact/core",
    "test:dist": "npm run test:dist -w @teact/core",
    "test:types": "npm run test:types -w @teact/core",
    "size": "npm run size -w @teact/core",
    "test:e2e": "npm run test -w teact-e2e",
    "test:mutations": "scripts/mutate-teact-dom.sh",
    "dev:demo": "npm run build && npm run dev -w teact-demo",
    "build:demo": "npm run build && npm run build -w teact-demo",
    "upstream:check": "node scripts/upstream-check.mjs",
    "check:e2e-upstream": "node scripts/check-e2e-upstream.mjs",
    "canary:web-a": "node scripts/canary/web-a/run.mjs",
    "canary:mtw": "node scripts/canary/mtw/run.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint-react/eslint-plugin": "5.24.10",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "14.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-null": "1.0.2",
    "eslint-plugin-react-hooks-static-deps": "github:zubiden/eslint-plugin-react-hooks-static-deps#160ac4ae8cc3819eb7d692ec7157ddf7da699f38",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "publint": "0.3.25",
    "size-limit": "14.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
